# Copie para .env e substitua somente com credenciais do ambiente de automacao.
SELFHOST_ENVIRONMENT=desktop
SELFHOST_BASE_URL=http://localhost:7711
SELFHOST_CLIENT_ID=
SELFHOST_CLIENT_SECRET=
SELFHOST_VERIFY_SSL=true
SELFHOST_REQUEST_TIMEOUT=30
SELFHOST_OPENAPI_PATH=/scalar/swagger/v1/swagger.json
SELFHOST_MESAS_DATABASE_ENABLED=false
