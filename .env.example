# No Desktop, cole a URL completa gerada pelo Gerenciador do Selfhost.
SELFHOST_ENVIRONMENT=desktop
SELFHOST_BASE_URL=http://localhost:7711
SELFHOST_DEVICE_URL=

# Fallback para WEB ou ambientes que usam credenciais previamente cadastradas.
SELFHOST_CLIENT_ID=
SELFHOST_CLIENT_SECRET=

# DricaIA: necessário somente para os endpoints /api/v2/dricaia/*.
SELFHOST_DRICAIA_EMAIL=
SELFHOST_DRICAIA_PASSWORD=

# Restaurante: habilita chamadas aos endpoints que dependem do módulo/banco de mesas.
SELFHOST_RESTAURANT_ENDPOINTS_ENABLED=false

# Escritas: habilite somente em uma base exclusiva de automação.
SELFHOST_DESTRUCTIVE_TESTS_ENABLED=false

SELFHOST_VERIFY_SSL=true
SELFHOST_REQUEST_TIMEOUT=30
SELFHOST_OPENAPI_PATH=/scalar/swagger/v1/swagger.json
